    {
        "id": "6576f5a53b95e68d",
        "type": "function",
        "z": "1424779d3b5549a9",
        "name": "Dist. Normal",
        "func": "const media = 25;\nconst desvioPadrao = 10;\n\nlet u1 = 0;\nlet u2 = 0;\nwhile(u1 === 0) u1 = Math.random(); \nu2 = Math.random();\nlet z = Math.sqrt(-2.0 * Math.log(u1)) * Math.cos(2.0 * Math.PI * u2);\n\nlet numeroNormal = media + z * desvioPadrao;\n\n//let numeroNormalround = Math.round(numeroNormal);\n\nlet numeroNormalround = Math.round(numeroNormal * 1000) / 1000;\n\n//let numeroNormalround = numeroNormal;\nmsg.payload = numeroNormalround;\nmsg.topic = \"Medição\"; \n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 370,
        "y": 400,
        "wires": [
