    {
        "id": "fe3deba4402cdeac",
        "type": "function",
        "z": "1424779d3b5549a9",
        "name": "function 4",
        "func": "const LIMITE_SUP = 45\nconst LIMITE_INF = 10\nvar tipo_alerta = null;\nvar saida_tabela = null; \n\n\nif (msg.payload > LIMITE_SUP) {\n    tipo_alerta = \"Limite Alto\";\n} else if (msg.payload < LIMITE_INF) {\n    tipo_alerta = \"Limite Baixo\";\n}\n\nif (tipo_alerta !== null) {\n    var now = new Date();\n    // Formata a data para pt-BR\n    var timestamp = now.toLocaleString('pt-BR', { \n        dateStyle: 'short', \n        timeStyle: 'medium' \n    });\n\n    var linha_tabela = {\n        \"DataHora\": timestamp,\n        \"Valor\": msg.payload,\n        \"Alerta\": tipo_alerta\n    };\n    \n    // Colocamos o objeto no payload da mensagem de saída\n    saida_tabela = { payload: linha_tabela };\n}\n\n\nreturn saida_tabela;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 620,
        "y": 380,
        "wires": [
            [
                "91a98e0e6673862e"
            ]
        ]
